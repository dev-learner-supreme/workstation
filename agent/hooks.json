{
  "jarvis-init": {
    "SessionStart": [
      {
        "type": "command",
        "command": "/home/arun/.agents/scripts/jarvis-session-init.py",
        "timeout": 5
      }
    ]
  },
  "jarvis-prod-safety": {
    "PreToolUse": [
