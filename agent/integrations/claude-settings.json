{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/omarchy/plugins/tornikegomareli.spaces/hooks/claude-hook working",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/omarchy/plugins/tornikegomareli.spaces/hooks/claude-hook working",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/omarchy/plugins/tornikegomareli.spaces/hooks/claude-hook done",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/omarchy/plugins/tornikegomareli.spaces/hooks/claude-hook end",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "theme": "auto",
  "model": "sonnet"
}
