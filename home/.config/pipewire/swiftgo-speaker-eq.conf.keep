# Acer Swift Go 14 (SFG14-71) speaker EQ -- conservative, builtin biquads only.
# Hosted the Omarchy way (omarchy-speaker-tuning.service). Max boost +2.5 dB
# against a -6 dB preamp, so no limiter is needed.
context.modules = [
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "Laptop Speakers"
      media.name       = "Laptop Speakers"
      filter.graph = {
        nodes = [
          { type = builtin name = pre  label = linear       control = { "Mult" = 0.501 } }
          { type = builtin name = hp1  label = bq_highpass  control = { "Freq" = 120.0  "Q" = 0.707 } }
          { type = builtin name = hp2  label = bq_highpass  control = { "Freq" = 120.0  "Q" = 0.707 } }
          { type = builtin name = warm label = bq_peaking   control = { "Freq" = 220.0  "Q" = 1.0 "Gain" = 2.5 } }
          { type = builtin name = box  label = bq_peaking   control = { "Freq" = 500.0  "Q" = 1.4 "Gain" = -2.5 } }
          { type = builtin name = pres label = bq_peaking   control = { "Freq" = 3000.0 "Q" = 1.0 "Gain" = 1.5 } }
          { type = builtin name = air  label = bq_highshelf control = { "Freq" = 9000.0 "Q" = 0.707 "Gain" = 2.0 } }
        ]
        links = [
          { output = "pre:Out"  input = "hp1:In" }
          { output = "hp1:Out"  input = "hp2:In" }
          { output = "hp2:Out"  input = "warm:In" }
          { output = "warm:Out" input = "box:In" }
          { output = "box:Out"  input = "pres:In" }
          { output = "pres:Out" input = "air:In" }
        ]
        inputs  = [ "pre:In" ]
        outputs = [ "air:Out" ]
      }
      # Mono graph, duplicated per channel.
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props = {
        node.name   = "omarchy_speaker_tuning"
        media.class = Audio/Sink
        priority.session = 1500
      }
      playback.props = {
        node.name          = "omarchy_speaker_tuning_output"
        node.passive       = true
        target.object      = "alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink"
        node.dont-move     = true
        node.dont-fallback = true
        node.linger        = true
      }
    }
  }
]
