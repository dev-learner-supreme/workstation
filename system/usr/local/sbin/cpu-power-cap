#!/bin/bash
# ==============================================================================
# CPU Power Cap Enforcement
# Target: Intel Core i5-13500H (RAPL MSR + MMIO)
# Applies PL1/PL2/tau limits to both package-0 RAPL interfaces.
# Verifies all writes via sysfs readback; fails closed if limits cannot be applied.
# ==============================================================================
set -euo pipefail

CONFIG="/etc/default/cpu-power-cap"

if [[ ! -r "$CONFIG" ]]; then
  logger -t cpu-power-cap "ERROR: Configuration file $CONFIG is missing or unreadable"
  exit 1
fi

# shellcheck source=/dev/null
. "$CONFIG"

# Validate numeric inputs
if ! [[ "${PL1_W:-}" =~ ^[0-9]+$ && "${PL2_W:-}" =~ ^[0-9]+$ && "${TAU_S:-}" =~ ^[0-9]+$ ]]; then
  logger -t cpu-power-cap "ERROR: Non-numeric power limits in $CONFIG (PL1_W='${PL1_W:-}', PL2_W='${PL2_W:-}', TAU_S='${TAU_S:-}')"
  exit 1
fi

# Hardware bounds verification for Intel Core i5-13500H (5W - 65W PL1, 10W - 115W PL2, 1s - 128s TAU)
if (( PL1_W < 5 || PL1_W > 65 || PL2_W < 10 || PL2_W > 115 || TAU_S < 1 || TAU_S > 128 )); then
  logger -t cpu-power-cap "ERROR: Power limits out of safe hardware bounds (PL1: ${PL1_W}W, PL2: ${PL2_W}W, TAU: ${TAU_S}s)"
  exit 1
fi

pl1=$((PL1_W * 1000000))
pl2=$((PL2_W * 1000000))
tau=$((TAU_S * 1000000))

write_errors=0

w() {
  local path="$1"
  local val="$2"
  
  [[ -e "$path" ]] || return 0
  
  if [[ ! -w "$path" ]]; then
    logger -t cpu-power-cap "ERROR: Sysfs path $path exists but is not writable"
    write_errors=$((write_errors + 1))
    return 1
  fi
  
  local cur
  cur="$(<"$path")" 2>/dev/null || cur=""
  if [[ "$cur" == "$val" ]]; then
    return 0
  fi
  
  if ! echo "$val" >"$path" 2>/dev/null; then
    logger -t cpu-power-cap "ERROR: Failed to write $val to $path"
    write_errors=$((write_errors + 1))
    return 1
  fi
  
  local readback
  readback="$(<"$path")" 2>/dev/null || readback=""
  
  if [[ "$readback" != "$val" ]]; then
    # Kernel rounds tau to nearest discrete RAPL hardware step
    if [[ "$path" == *"time_window_us"* ]]; then
      if [[ -n "$readback" ]] && (( readback >= val * 90 / 100 && readback <= val * 110 / 100 )); then
        logger -t cpu-power-cap "verified $path=$readback (rounded from $val)"
        return 0
      fi
    fi
    logger -t cpu-power-cap "ERROR: Verification failed for $path (expected $val, read back $readback)"
    write_errors=$((write_errors + 1))
    return 1
  fi
  
  logger -t cpu-power-cap "set and verified $path=$val"
  return 0
}

found_interface=0
for z in /sys/class/powercap/intel-rapl:0 /sys/class/powercap/intel-rapl-mmio:0; do
  [[ -d "$z" && -r "$z/name" && "$(<"$z/name")" == "package-0" ]] || continue
  found_interface=1
  w "$z/constraint_0_power_limit_uw" "$pl1"
  w "$z/constraint_1_power_limit_uw" "$pl2"
  
  # Kernel rounds tau to nearest RAPL step; only rewrite if off by >5%
  if [[ -r "$z/constraint_0_time_window_us" ]]; then
    cur="$(<"$z/constraint_0_time_window_us")"
    if (( cur < tau * 95 / 100 || cur > tau * 105 / 100 )); then
      w "$z/constraint_0_time_window_us" "$tau"
    fi
  fi
  w "$z/enabled" 1
done

if (( found_interface == 0 )); then
  logger -t cpu-power-cap "WARN: No compatible Intel RAPL package-0 powercap interfaces found"
  exit 0
fi

if (( write_errors > 0 )); then
  logger -t cpu-power-cap "ERROR: Encountered $write_errors write/verification errors while applying power limits"
  exit 1
fi

exit 0
